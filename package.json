{
  "name": "@dsh-external/dsh-plugin-manager",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin manager: list every plugin (deployment + dynamic Cordis), keep per-plugin notes persisted to disk, export/import notes for backup, start/stop dynamic plugins, and toggle deployment plugins on/off with one click — with a Settings UI tab and a plugin_manager model tool.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin-manager",
    "plugin-notes",
    "cordis",
    "plugin"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dynamic",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
